{
  "name": "@baryonyx/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "wrangler dev --local --ip 127.0.0.1 --port 3000",
    "build": "wrangler deploy --dry-run --outdir dist",
    "start": "wrangler dev --local --no-bundle dist/index.js --ip 127.0.0.1 --port 3000",
    "types": "wrangler types",
    "typecheck": "wrangler types && tsc --noEmit -p tsconfig.json",
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "wrangler deploy --dry-run --outdir dist && vitest run",
    "test:watch": "wrangler deploy --dry-run --outdir dist && vitest",
    "test:ci": "node --test scripts/*.test.mjs",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "artifact": "node scripts/artifact.mjs"
  },
  "dependencies": {
    "hono": "4.13.7",
    "jose": "6.1.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@types/node": "24.13.3",
    "miniflare": "5.20260908.0-alpha",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "5.0.0",
    "wrangler": "4.130.0"
  }
}
